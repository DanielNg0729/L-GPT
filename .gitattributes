# Model weights go through Git LFS. The pattern is a GLOB rather than one literal path:
# it used to name only the scaffolding tagger, so a second checkpoint added later went in
# as a plain blob and GitHub rejected the push at its 100 MB limit.
submission/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
submission/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
submission/models/**/*.pt filter=lfs diff=lfs merge=lfs -text
