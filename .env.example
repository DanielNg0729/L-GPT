# Recommended final-evaluation configuration: permit network access and set GROQ_API_KEY.
# This enables semantic recovery for unfamiliar customer wording. Leave it empty only to
# force the deterministic offline fallback. Never commit a real key.
GROQ_API_KEY=

# Active optional hosted layers. Both are inert without GROQ_API_KEY.
LLM_RESOLVE=1
LLM_RESCUE=1

# Transcript rescue only runs after a stalled session reaches both thresholds.
LLM_RESCUE_TURN=5
LLM_RESCUE_REJECTS=4

# Active guarded local layers. They fail closed if their optional weights are unavailable.
V2_ROUTE=1
BERT_EXTRACT=1
BERT_KEEP=0.30

# ---------------------------------------------------------------------------
# EVERYTHING BELOW IS READ BY THE CODE BUT SHOULD NOT BE SET. Listed so the set
# is complete and nothing is undisclosed -- not because any of it is needed. The
# defaults are what produced the reported result, and the public-set score is
# reproducible with no .env file at all.
# ---------------------------------------------------------------------------

# Checkpoint location. Leave unset: resolution already prefers a local directory
# that actually contains weights and otherwise uses the Hub, which is what a
# fresh clone needs. Point these at a directory only if you genuinely have one;
# a path without weights in it is ignored and the Hub is used instead.
# BERT_TAGGER_DIR=
# V2_ROUTE_MODEL_DIR=

# Checkpoint Hub ids. Leave unset unless you are mirroring our published models.
# BERT_TAGGER_HUB=KhiemGOM/techjam-scaffolding-tagger
# V2_ROUTE_HUB=KhiemGOM/techjam-route-classifier

# Tagger device. Leave unset; `auto` uses CUDA when present and CPU otherwise.
# Irrelevant to the reported score -- the tagger never loads on the public set.
# BERT_DEVICE=auto

# DO NOT SET GROQ_MODEL. Each hosted layer chooses its own model in code. Setting
# this overrides all of them at once and moves them onto a model they were never
# measured on.
# GROQ_MODEL=

# Clarification-question phrasing variety. Presentation only: the simulator reads
# the structured `ask_attribute`, never the prose, so this cannot affect scoring.
# MESSAGE_VARIETY=1
