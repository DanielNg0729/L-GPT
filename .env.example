# Optional external extraction. The default release does not require it.
GROQ_API_KEY=
LLM_EXTRACT=0
LLM_RERANK=0
GROQ_MODEL=openai/gpt-oss-120b
LLM_RPM=25
LLM_TPM=5500
LLM_TIME_BUDGET=5400
LLM_EXTRACT_CACHE=submission/.llm_extract_cache.json
LLM_CACHE=submission/.llm_cache.json

# Set to 0 to force the standard-library-only extraction path.
BERT_EXTRACT=1
BERT_TAGGER_DIR=submission/models/scaffolding_tagger
BERT_KEEP=0.30
