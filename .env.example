# Copy to .env. Every value here is OPTIONAL: with no .env at all the agent runs its
# full offline path and scores identically on the public set. Nothing below is required
# to reproduce the reported result.

# ---------------------------------------------------------------- configurable layers
# The span node is unconditional deterministic core, so it is not counted here. There
# are five configurable layers: route, tagger, resolver, rescue, and message writing.
# With a Groq key, this file enables four of five; the message writer stays off.
# Without a key, only the two local layers below are active.
#
# Local, no credential, no network, no per-call cost. On by default; set to 0 to disable.
V2_ROUTE=1            # dialogue-act router for unfamiliar wrappers
BERT_EXTRACT=1        # scaffolding tagger
BERT_KEEP=0.30        # keep-probability threshold for the tagger
MESSAGE_VARIETY=1     # deterministic phrasing variety (pure string work)

# DO NOT SET BERT_TAGGER_DIR OR V2_ROUTE_MODEL_DIR.
# Both are absolute overrides: they are returned ahead of the local-weights check AND
# ahead of the Hub fallback. `submission/models/` is gitignored, so on a fresh clone the
# local path does not exist -- an override then points at a directory that is not there,
# the load raises, and the layer disables itself SILENTLY. Left unset, resolution is:
# local weights if genuinely present, otherwise the Hub, which is what a clone needs.
# Set them only when pointing at a training output on a machine that has one.

# ---------------------------------------------------------------- hosted layers
# Resolver and rescue are configured on, but inert until a key is present. Paste a key
# here to activate them. Never commit it.
GROQ_API_KEY=
LLM_RESOLVE=1         # deparaphraser: unattested value -> catalogue-attested value
LLM_RESCUE=1          # whole-transcript recovery on a stalled session
LLM_MESSAGE=0         # phrasing writer: measured no score gain, off by design

# Do not set GROQ_MODEL globally. The hosted layers select their measured model in code.

LLM_RPM=25
LLM_TPM=5500
LLM_TIME_BUDGET=5400

# Rescue gate. Defaults suit the simulator (which answers in two-constraint bursts);
# lower both only for interactive use, where a person stalls sooner.
# LLM_RESCUE_TURN=5
# LLM_RESCUE_REJECTS=4
