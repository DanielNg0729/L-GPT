# Optional hosted semantic recovery. Leave GROQ_API_KEY empty for the fully offline path.
# Never commit a real key.
GROQ_API_KEY=

# Active optional hosted layers. Both are inert without GROQ_API_KEY.
LLM_RESOLVE=1
LLM_RESCUE=1

# Transcript rescue only runs after a stalled session reaches both thresholds.
LLM_RESCUE_TURN=5
LLM_RESCUE_REJECTS=4

# Active guarded local layers. They fail closed if their optional weights are unavailable.
V2_ROUTE=1
BERT_EXTRACT=1
BERT_KEEP=0.30
