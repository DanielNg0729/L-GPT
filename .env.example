# Credentials for the OPTIONAL LLM rescue (copilot/llm_rescue.py).
# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# The agent does not need any of this. It scores 0.890686 on the public set with
# enable_llm_rescue=False, which is the default, and runs with no network at all.

# Groq (default provider), serving openai/gpt-oss-20b
GROQ_API_KEY=

# Local alternative - no key needed, just a running ollama:
#   ollama pull gpt-oss:20b
# then set llm_provider="ollama" in CopilotConfig.
# OLLAMA_BASE_URL=http://localhost:11434
